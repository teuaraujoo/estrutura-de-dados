    {
      "type": "text",
      "version": 143,
      "id": "el9IPvaaevJwfUtnyPqBr",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -792.9501956977011,
      "y": -61.28749991793843,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "width": 264.75788125602736,
      "height": 547.0209486482493,
      "seed": 1923141794,
      "groupIds": [
        "FygjiA5lovwVcBHjGSycf"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1789070905086,
      "link": null,
      "locked": false,
      "fontSize": 15.0902330661586,
      "fontFamily": 6,
      "text": "1. 🔥 DESPERDÍCIO DE TOKENS\n   • 99% do contexto não usado\n   • Custos altíssimos\n   • Latência aumentada\n\n2. 🐌 PERFORMANCE RUIM\n   • Contexto gigante = lento\n   • Processamento desnecessário\n   • Hit de context limits rápido\n\n3. 🎯 FALTA DE FOCO\n   • Informação irrelevante confunde\n   • Conflitos entre instruções\n   • Piora qualidade das respostas\n\n4. 🔀 SEM MODULARIZAÇÃO\n   • Tudo misturado\n   • Difícil manter/atualizar\n   • Sem reusabilidade\n\n5. 📈 NÃO ESCALA\n   • Quanto mais features, pior\n   • Context window explode\n   • Impossível adicionar mais\n\n6. 🚫 SEM ESPECIALIZAÇÃO\n   • Não dá pra ter subagents eficientes\n   • Contexto único para tudo\n   • Zero isolamento",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 🔥 DESPERDÍCIO DE TOKENS\n   • 99% do contexto não usado\n   • Custos altíssimos\n   • Latência aumentada\n\n2. 🐌 PERFORMANCE RUIM\n   • Contexto gigante = lento\n   • Processamento desnecessário\n   • Hit de context limits rápido\n\n3. 🎯 FALTA DE FOCO\n   • Informação irrelevante confunde\n   • Conflitos entre instruções\n   • Piora qualidade das respostas\n\n4. 🔀 SEM MODULARIZAÇÃO\n   • Tudo misturado\n   • Difícil manter/atualizar\n   • Sem reusabilidade\n\n5. 📈 NÃO ESCALA\n   • Quanto mais features, pior\n   • Context window explode\n   • Impossível adicionar mais\n\n6. 🚫 SEM ESPECIALIZAÇÃO\n   • Não dá pra ter subagents eficientes\n   • Contexto único para tudo\n   • Zero isolamento",
      "lineHeight": 1.25,
      "versionNonce": 2113155549,
      "index": "b1N",
      "isDeleted": false,
      "autoResize": true,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 93,
      "id": "MSIZNpLfNd_X-jv0TvCRY",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -1661.672086403798,
